generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserType {
  INDIVIDUAL
  BUSINESS
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  FROZEN
  CLOSED
}

enum KYCLevel {
  UNVERIFIED
  BASIC
  VERIFIED
  PREMIUM
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum Currency {
  USD
  EUR
  GBP
  MAD
  AED
  BTC
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  REFUND
  FEE
  EXCHANGE
  SPLIT_BILL
  QR_PAYMENT
  EXPENSE
  INCOME
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  EXPIRED
  CANCELLED
}

enum CardProvider {
  VISA
  MASTERCARD
}

enum PaymentRequestStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  EXPIRED
}

enum SplitBillStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum SplitBillParticipantStatus {
  PENDING
  PAID
  DECLINED
}

enum BudgetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TRANSACTION
  SECURITY
  KYC
  PROMOTIONAL
  SYSTEM
  BILL
  REMINDER
  FRAUD_ALERT
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  INVESTIGATING
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  TRANSACTION_CREATED
  TRANSACTION_APPROVED
  TRANSACTION_REJECTED
  WALLET_CREATED
  CARD_ISSUED
  CARD_BLOCKED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_LOGIN
  ADMIN_ACTION
  FRAUD_DETECTED
  SECURITY_ALERT
  SPLIT_BILL_CREATED
  PAYMENT_REQUEST_SENT
  OTP_DISPATCHED
  USER_REGISTER_VERIFIED
  USER_SIGNIN
  USER_SIGNOUT
  MFA_PROMPT
  PASSWORD_RESET_DISPATCH
  PASSWORD_RESET_SUCCESS
  EMERGENCY_FREEZE
  EMERGENCY_THAW
  BIOMETRIC_ENABLED
  BIOMETRIC_DISABLED
  TWOFA_ENABLED
  TWOFA_DISABLED
  TRANSFER_SENT
  SUSPICIOUS_TRANSFER
  CURRENCY_EXCHANGE
  CARD_CREATED
  CARD_REQUESTED
  CARD_FROZEN
  CARD_UNFROZEN
  ADMIN_USER_STATUS
  ADMIN_FREEZE_USER
  ADMIN_RESTRICT_USER
  ADMIN_KYC_REVIEW
  ADMIN_FREEZE
  ADMIN_UNFREEZE
  ADMIN_TICKET_UPDATE
  ADMIN_EMERGENCY_FREEZE
  USER_UPDATE
  SETTINGS_ADJUSTED
}

// ============================================================
// 1. USERS
// ============================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  userType        UserType  @default(INDIVIDUAL)
  status          UserStatus @default(PENDING)
  kycLevel        KYCLevel  @default(UNVERIFIED)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  failedLoginAttempts Int   @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile              UserProfile?
  devices              Device[]
  sessions             Session[]
  biometricEnrolled    Boolean   @default(false)
  kycVerifications     KYCVerification[]
  wallets              Wallet[]
  paymentRequestsSent  PaymentRequest[]  @relation("SentPaymentRequests")
  paymentRequestsRecv  PaymentRequest[]  @relation("ReceivedPaymentRequests")
  qrPayments           QRPayment[]
  splitBillsCreated    SplitBill[]
  splitBillParticipant SplitBillParticipant[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  subscriptions        Subscription[]
  aiInsights           AIInsight[]
  businessMemberships  BusinessMember[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  fraudEvents          FraudEvent[]
   loginHistory         LoginHistory[]
   cards                Card[]
   auditLogs            AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([kycLevel])
  @@map("users")
}

// ============================================================
// 2. USER PROFILES
// ============================================================

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  nationality String?
  country     String?
  city        String?
  address     String?
  postalCode  String?
  avatarUrl   String?
  occupation  String?
  employer    String?
  annualIncome Decimal? @db.Decimal(15, 2)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================================
// 3. DEVICES
// ============================================================

model Device {
  id          String   @id @default(uuid())
  userId      String  
  deviceName  String
  deviceModel String?
  os          String?
  browser     String?
  ipAddress   String?
  location    String?
  isTrusted   Boolean  @default(false)
  isActive    Boolean  @default(true)
  lastActive  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("devices")
}

// ============================================================
// 4. SESSIONS
// ============================================================

model Session {
  id           String   @id @default(uuid())
  userId       String  
  refreshTokenHash String
  deviceId     String? 
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// 5. KYC VERIFICATIONS
// ============================================================

model KYCVerification {
  id              String    @id @default(uuid())
  userId          String   
  documentType    String
  documentNumber String    @db.VarChar(255)
  frontImageUrl   String?
  backImageUrl    String?
  selfieUrl       String?
  status          KYCStatus @default(NOT_SUBMITTED)
  level           KYCLevel  @default(UNVERIFIED)
  rejectionReason String?
  verifiedBy      String?  
  verifiedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_verifications")
}

// ============================================================
// 6. WALLETS
// ============================================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String  
  currency  Currency @default(USD)
  balance   Decimal  @default(0) @db.Decimal(20, 2)
  ledgerBalance Decimal @default(0) @db.Decimal(20, 2)
  isActive  Boolean  @default(true)
  label     String?  @default("Primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]     @relation("WalletTransactions")
  sentTrans    Transaction[]     @relation("SenderWalletTransactions")
  cards        Card[]
  splitBills   SplitBill[]

  @@unique([userId, currency])
  @@index([userId])
  @@index([currency])
  @@map("wallets")
}

// ============================================================
// 7. TRANSACTIONS
// ============================================================

model Transaction {
  id              String            @id @default(uuid())
  walletId        String           
  senderWalletId  String?          
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(20, 2)
  fee             Decimal           @default(0) @db.Decimal(20, 2)
  currency        Currency          @default(USD)
  exchangeRate    Decimal?          @db.Decimal(12, 6)
  description String?
  reference       String?           @unique
  categoryId      String?
  merchantCategoryId String?
  senderId        String?          
  recipientId     String?          
  recipientWallet String?
  recipientName   String?
  metadata        Json?
  reversalReason  String?
  reversedAt      DateTime?
  failedReason    String?
  approvedBy      String?          
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  wallet         Wallet            @relation("WalletTransactions", fields: [walletId], references: [id])
  senderWallet   Wallet?           @relation("SenderWalletTransactions", fields: [senderWalletId], references: [id])

  @@index([walletId])
  @@index([senderWalletId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@index([categoryId])
  @@index([senderId])
  @@index([recipientId])
  @@map("transactions")
}

// ============================================================
// 8. CARDS
// ============================================================

model Card {
  id              String     @id @default(uuid())
  walletId        String    
  userId          String    
  type            CardType   @default(VIRTUAL)
  status          CardStatus @default(ACTIVE)
  provider        CardProvider @default(VISA)
  maskedPan       String
  panHash         String     @unique
  cvvHash         String
  expiryMonth     Int
  expiryYear      Int
  cardholderName  String
  issuingCountry  String?
  currency        Currency   @default(USD)
  dailyLimit      Decimal?   @db.Decimal(20, 2)
  monthlyLimit    Decimal?   @db.Decimal(20, 2)
  singleLimit     Decimal?   @db.Decimal(20, 2)
  isDomesticOnly  Boolean    @default(false)
  isContactless   Boolean    @default(true)
  isOnlineEnabled Boolean    @default(true)
  blockedReason   String?
  frozenAt        DateTime?
  activatedAt     DateTime?
  lastUsedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@index([maskedPan])
  @@map("cards")
}

// ============================================================
// 9. PAYMENT REQUESTS
// ============================================================

model PaymentRequest {
  id              String               @id @default(uuid())
  senderId        String              
  recipientId     String              
  walletId        String              
  amount          Decimal              @db.Decimal(20, 2)
  currency        Currency             @default(USD)
  description     String?
  status          PaymentRequestStatus @default(PENDING)
  transactionId   String?             
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  sender      User        @relation("SentPaymentRequests", fields: [senderId], references: [id])
  recipient   User        @relation("ReceivedPaymentRequests", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("payment_requests")
}

// ============================================================
// 10. QR PAYMENTS
// ============================================================

model QRPayment {
  id              String             @id @default(uuid())
  userId          String            
  walletId        String            
  amount          Decimal            @db.Decimal(20, 2)
  currency        Currency           @default(USD)
  description     String?
  qrCodeData      String
  status          PaymentRequestStatus @default(PENDING)
  scannedById     String?           
  transactionId   String?           
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("qr_payments")
}

// ============================================================
// 11. SPLIT BILLS
// ============================================================

model SplitBill {
  id            String         @id @default(uuid())
  creatorId     String        
  walletId      String        
  title         String
  totalAmount   Decimal        @db.Decimal(20, 2)
  currency      Currency       @default(USD)
  status        SplitBillStatus @default(OPEN)
  settledAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  creator      User                   @relation(fields: [creatorId], references: [id])
  wallet       Wallet                 @relation(fields: [walletId], references: [id])
  participants SplitBillParticipant[]

  @@index([creatorId])
  @@index([status])
  @@map("split_bills")
}

// ============================================================
// 12. SPLIT BILL PARTICIPANTS
// ============================================================

model SplitBillParticipant {
  id              String                       @id @default(uuid())
  splitBillId     String                      
  userId          String                      
  amount          Decimal                      @db.Decimal(20, 2)
  status          SplitBillParticipantStatus   @default(PENDING)
  transactionId   String?                     
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  splitBill SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([splitBillId, userId])
  @@index([userId])
  @@map("split_bill_participants")
}

// ============================================================
// 13. SPENDING CATEGORIES
// ============================================================

// ============================================================
// 15. BUDGETS
// ============================================================

model Budget {
  id          String       @id @default(uuid())
  userId      String      
  categoryId  String?     
  name        String
  amount      Decimal      @db.Decimal(20, 2)
  period      BudgetPeriod @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  spent       Decimal      @default(0) @db.Decimal(20, 2)
  rollover    Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("budgets")
}

// ============================================================
// 16. SAVINGS GOALS
// ============================================================

model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String  
  name          String
  targetAmount  Decimal  @db.Decimal(20, 2)
  currentAmount Decimal  @default(0) @db.Decimal(20, 2)
  currency      Currency @default(USD)
  targetDate    DateTime?
  isAutoSave    Boolean  @default(false)
  autoSaveAmount Decimal? @db.Decimal(20, 2)
  autoSaveFreq  String?
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
  @@map("savings_goals")
}

// ============================================================
// 17. SUBSCRIPTIONS
// ============================================================

model Subscription {
  id              String             @id @default(uuid())
  userId          String            
  name            String
  description     String?
  amount          Decimal            @db.Decimal(20, 2)
  currency        Currency           @default(USD)
  billingCycle    String
  provider        String?
  categoryId      String?           
  nextBillingDate DateTime
  status          SubscriptionStatus @default(ACTIVE)
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

// ============================================================
// 18. AI INSIGHTS
// ============================================================

model AIInsight {
  id          String   @id @default(uuid())
  userId      String  
  type        String
  title       String
  description String
  data        Json?
  isRead      Boolean  @default(false)
  isActioned  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_insights")
}

// ============================================================
// 19. CLIENTS (Invoice clients for businesses)
// ============================================================

model Client {
  id          String   @id @default(uuid())
  businessId  String  
  name        String
  email       String?
  phone       String?
  address     String?
  taxId       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([businessId])
  @@map("clients")
}

// ============================================================
// 20. INVOICES
// ============================================================

model Invoice {
  id            String    @id @default(uuid())
  businessId    String   
  clientId      String?  
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(20, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(20, 2)
  totalAmount   Decimal   @db.Decimal(20, 2)
  currency      Currency  @default(USD)
  description   String?
  status        String    @default("DRAFT")
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client?  @relation(fields: [clientId], references: [id])

  @@index([businessId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ============================================================
// 21. BUSINESSES
// ============================================================

model Business {
  id            String   @id @default(uuid())
  name          String
  legalName     String?
  email         String?  @unique
  phone         String?
  taxId         String?  @unique
  registrationNumber String? @unique
  industry      String?
  website       String?
  logoUrl       String?
  country       String?
  city          String?
  address       String?
  isVerified    Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members  BusinessMember[]
  clients  Client[]
  invoices Invoice[]

  @@index([status])
  @@map("businesses")
}

// ============================================================
// 22. BUSINESS MEMBERS
// ============================================================

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String  
  userId     String  
  role       String   @default("MEMBER")
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// ============================================================
// 23. SUPPORT TICKETS
// ============================================================

model SupportTicket {
  id          String               @id @default(uuid())
  userId      String              
  subject     String
  description String
  status      SupportTicketStatus  @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  category    String?
  assignedTo  String?             
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user     User                    @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@map("support_tickets")
}

// ============================================================
// 24. SUPPORT TICKET MESSAGES
// ============================================================

model SupportTicketMessage {
  id         String   @id @default(uuid())
  ticketId   String  
  senderId   String  
  message    String
  attachments Json?
  isStaff    Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_ticket_messages")
}

// ============================================================
// 25. NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String          
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// 26. FRAUD EVENTS
// ============================================================

model FraudEvent {
  id          String        @id @default(uuid())
  userId      String       
  ruleName    String
  severity    FraudSeverity @default(MEDIUM)
  status      FraudStatus   @default(INVESTIGATING)
  description String
  transactionId String?    
  ipAddress   String?
  deviceId    String?      
  location    String?
  metadata    Json?
  reviewedBy  String?      
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("fraud_events")
}

// ============================================================
// 27. LOGIN HISTORY
// ============================================================

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String  
  ipAddress  String?
  userAgent  String?
  deviceId   String? 
  location   String?
  isSuccess  Boolean  @default(true)
  failureReason String?
  method     String   @default("PASSWORD")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([isSuccess])
  @@map("login_history")
}

// ============================================================
// 28. SECURITY ALERTS
// ============================================================

// ============================================================
// 29. ADMIN USERS
// ============================================================

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("ADMIN")
  isSuperAdmin  Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs   AuditLog[]

  @@index([email])
  @@index([role])
  @@map("admin_users")
}

// ============================================================
// 30. ADMIN PERMISSIONS
// ============================================================


// ============================================================
// 31. AUDIT LOGS
// ============================================================

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?    
  adminUserId String?    
  action      AuditAction
  resource    String
  resourceId  String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([userId])
  @@index([adminUserId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
