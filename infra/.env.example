# ==========================================
# FLOW Fintech — Environment Configuration
# ==========================================

# --- Database ---
DATABASE_URL="postgresql://flow_user:flow_dev_pass_2026@localhost:5432/flow_fintech?schema=public"

# --- Redis ---
REDIS_URL="redis://:flow_redis_pass_2026@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flow_redis_pass_2026

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ACCESS_KEY=flow_minio_admin
MINIO_SECRET_KEY=flow_minio_pass_2026
MINIO_BUCKET_KYC=flow-kyc
MINIO_BUCKET_INVOICES=flow-invoices
MINIO_BUCKET_AVATARS=flow-avatars
MINIO_BUCKET_REPORTS=flow-reports
MINIO_REGION=us-east-1

# --- JWT ---
JWT_ACCESS_SECRET=flow-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=flow-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Encryption ---
ENCRYPTION_KEY=flow-encryption-key-32byte-change-in-prod
OTP_ENCRYPTION_KEY=flow-otp-key-change-in-production

# --- Email (Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@flow.finance

# --- Backend ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=flow-backend

# --- Prometheus ---
PROMETHEUS_METRICS_PORT=9464

# --- Queue (BullMQ) ---
QUEUE_EMAIL=flow-email-queue
QUEUE_NOTIFICATION=flow-notification-queue
QUEUE_TRANSACTION=flow-transaction-queue
QUEUE_FRAUD=flow-fraud-queue
QUEUE_KYC=flow-kyc-queue
