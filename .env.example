# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://flow:flow@localhost:5432/flow_fintech?schema=public"

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── Auth ──────────────────────────────────────────────────────────
# Use long random strings. The server falls back to a dev placeholder
# if these are unset, so always set them outside local development.
JWT_SECRET="replace-with-a-long-random-string"
REFRESH_SECRET="replace-with-a-different-long-random-string"

# ── Gemini (optional) ─────────────────────────────────────────────
# Without this the AI search endpoint just falls back to local results.
GEMINI_API_KEY=""

# ── MinIO (S3-compatible object storage) ──────────────────────────
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_REGION="us-east-1"

# ── Email ─────────────────────────────────────────────────────────
# 1025 is the default Mailpit port, which catches mail in dev
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="noreply@flow.local"

# ── Server ────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
